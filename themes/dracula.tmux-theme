#
# slot map:
#   1=status-bg  2=pane-border  3=muted-text  4=accent  5=highlight
#   6,7,8=status-left fg   9,10,11=status-left bg
#   12,13,14=status-right fg   15,16,17=status-right bg
tmux_conf_theme_colour_1="#282a36"    # bg
tmux_conf_theme_colour_2="#44475a"    # current line
tmux_conf_theme_colour_3="#6272a4"    # comment
tmux_conf_theme_colour_4="#bd93f9"    # purple
tmux_conf_theme_colour_5="#f1fa8c"    # yellow
tmux_conf_theme_colour_6="#282a36"
tmux_conf_theme_colour_7="#f8f8f2"    # fg
tmux_conf_theme_colour_8="#282a36"
tmux_conf_theme_colour_9="#ff79c6"    # pink
tmux_conf_theme_colour_10="#bd93f9"   # purple
tmux_conf_theme_colour_11="#50fa7b"   # green
tmux_conf_theme_colour_12="#6272a4"
tmux_conf_theme_colour_13="#f8f8f2"
tmux_conf_theme_colour_14="#f8f8f2"
tmux_conf_theme_colour_15="#282a36"
tmux_conf_theme_colour_16="#ff5555"   # red
tmux_conf_theme_colour_17="#44475a"
tmux_conf_theme_window_bg="#282a36"
tmux_conf_theme_focused_pane_bg="#21222c"
