# peach-pink — warm peach/rose palette
#
# slot map:
#   1=status-bg  2=pane-border  3=muted-text  4=accent  5=highlight
#   6,7,8=status-left fg   9,10,11=status-left bg
#   12,13,14=status-right fg   15,16,17=status-right bg
tmux_conf_theme_colour_1="#2b1a24"    # deep plum (base)
tmux_conf_theme_colour_2="#4a2c3a"    # current line
tmux_conf_theme_colour_3="#a8788c"    # dusty rose
tmux_conf_theme_colour_4="#ff8fab"    # peach pink
tmux_conf_theme_colour_5="#ffc2d1"    # light peach
tmux_conf_theme_colour_6="#2b1a24"
tmux_conf_theme_colour_7="#ffe3ee"    # light text
tmux_conf_theme_colour_8="#2b1a24"
tmux_conf_theme_colour_9="#ff8fab"    # peach pink
tmux_conf_theme_colour_10="#a34a68"   # deep rose
tmux_conf_theme_colour_11="#ffc2d1"   # light peach
tmux_conf_theme_colour_12="#a8788c"
tmux_conf_theme_colour_13="#ffe3ee"
tmux_conf_theme_colour_14="#ffffff"
tmux_conf_theme_colour_15="#2b1a24"
tmux_conf_theme_colour_16="#ff8fab"   # peach pink
tmux_conf_theme_colour_17="#4a2c3a"
tmux_conf_theme_window_bg="#2b1a24"
tmux_conf_theme_focused_pane_bg="#33202c"
