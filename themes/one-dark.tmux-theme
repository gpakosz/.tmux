# one dark — https://github.com/atom/one-dark-syntax
#
# slot map:
#   1=status-bg  2=pane-border  3=muted-text  4=accent  5=highlight
#   6,7,8=status-left fg   9,10,11=status-left bg
#   12,13,14=status-right fg   15,16,17=status-right bg
tmux_conf_theme_colour_1="#282c34"    # bg
tmux_conf_theme_colour_2="#3e4451"    # line
tmux_conf_theme_colour_3="#5c6370"    # comment
tmux_conf_theme_colour_4="#61afef"    # blue
tmux_conf_theme_colour_5="#e5c07b"    # yellow
tmux_conf_theme_colour_6="#282c34"
tmux_conf_theme_colour_7="#abb2bf"    # fg
tmux_conf_theme_colour_8="#282c34"
tmux_conf_theme_colour_9="#c678dd"    # purple
tmux_conf_theme_colour_10="#61afef"   # blue
tmux_conf_theme_colour_11="#98c379"   # green
tmux_conf_theme_colour_12="#5c6370"
tmux_conf_theme_colour_13="#abb2bf"
tmux_conf_theme_colour_14="#abb2bf"
tmux_conf_theme_colour_15="#282c34"
tmux_conf_theme_colour_16="#e06c75"   # red
tmux_conf_theme_colour_17="#3e4451"
tmux_conf_theme_window_bg="#282c34"
tmux_conf_theme_focused_pane_bg="#21252b"
